module uart_rx #(
    parameter CLKS_PER_BIT = 16
)(
    input        clk,
    input        reset,
    input        baud_tick,
    input        rx,

    output reg [7:0] data_out,
    output reg       received_parity,
    output reg       rx_done,
    output reg       frame_error
);

reg [7:0] data_reg;

reg [3:0] bit_count;

reg [15:0] sample_count;

reg [2:0] state;

localparam IDLE   = 3'b000;
localparam START  = 3'b001;
localparam DATA   = 3'b010;
localparam PARITY = 3'b011;
localparam STOP   = 3'b100;

always @(posedge clk or posedge reset) begin

    if (reset) begin

        data_out        <= 8'h00;
        data_reg        <= 8'h00;
        received_parity <= 1'b0;

        rx_done         <= 1'b0;
        frame_error     <= 1'b0;

        bit_count       <= 4'd0;
        sample_count    <= 16'd0;

        state           <= IDLE;

    end

    else begin

        rx_done <= 1'b0;

        case (state)

            // --------------------------------
            // WAIT FOR START BIT
            // --------------------------------

            IDLE: begin

                sample_count <= 16'd0;
                bit_count    <= 4'd0;

                if (rx == 1'b0) begin

                    sample_count <= 16'd0;
                    state <= START;

                end

            end


            // --------------------------------
            // SAMPLE MIDDLE OF START BIT
            // --------------------------------

            START: begin

                if (sample_count == (CLKS_PER_BIT/2)-1) begin

                    sample_count <= 16'd0;

                    if (rx == 1'b0) begin
                        state <= DATA;
                    end

                    else begin
                        state <= IDLE;
                    end

                end

                else begin

                    sample_count <= sample_count + 1'b1;

                end

            end


            // --------------------------------
            // RECEIVE 8 DATA BITS
            // --------------------------------

            DATA: begin

                if (sample_count == CLKS_PER_BIT-1) begin

                    sample_count <= 16'd0;

                    data_reg[bit_count] <= rx;

                    if (bit_count == 4'd7) begin

                        bit_count <= 4'd0;
                        state <= PARITY;

                    end

                    else begin

                        bit_count <= bit_count + 1'b1;

                    end

                end

                else begin

                    sample_count <= sample_count + 1'b1;

                end

            end


            // --------------------------------
            // RECEIVE PARITY
            // --------------------------------

            PARITY: begin

                if (sample_count == CLKS_PER_BIT-1) begin

                    sample_count <= 16'd0;

                    received_parity <= rx;

                    state <= STOP;

                end

                else begin

                    sample_count <= sample_count + 1'b1;

                end

            end


            // --------------------------------
            // RECEIVE STOP BIT
            // --------------------------------

            STOP: begin

                if (sample_count == CLKS_PER_BIT-1) begin

                    sample_count <= 16'd0;

                    if (rx == 1'b1) begin

                        data_out <= data_reg;
                        rx_done <= 1'b1;
                        frame_error <= 1'b0;

                    end

                    else begin

                        frame_error <= 1'b1;

                    end

                    state <= IDLE;

                end

                else begin

                    sample_count <= sample_count + 1'b1;

                end

            end


            default: begin

                state <= IDLE;

            end

        endcase

    end

end

endmodule
