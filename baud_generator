module baud_generator #(
    parameter CLKS_PER_BIT = 16
)(
    input  clk,
    input  reset,
    output reg baud_tick
);

reg [15:0] count;

always @(posedge clk or posedge reset) begin

    if (reset) begin
        count     <= 16'd0;
        baud_tick <= 1'b0;
    end

    else begin

        if (count == CLKS_PER_BIT - 1) begin
            count     <= 16'd0;
            baud_tick <= 1'b1;
        end

        else begin
            count     <= count + 1'b1;
            baud_tick <= 1'b0;
        end

    end

end

endmodule
